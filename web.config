<configuration>
  <system.webServer>
    <handlers>
      <add name="iisnode" path="dist/main.js" verb="*" modules="iisnode"/>
    </handlers>

    <rewrite>
      <rules>
        <rule name="Node">
          <match url=".*" />
          <action type="Rewrite" url="dist/main.js"/>
        </rule>
      </rules>
    </rewrite>

    <iisnode
      node_env="production"
      loggingEnabled="true"
      devErrorsEnabled="true"
    />
  </system.webServer>
</configuration>